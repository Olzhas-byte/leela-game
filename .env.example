# ── База данных (Railway Postgres plugin) ───────────────────────────────────
# Railway выдаёт строку подключения автоматически в переменную DATABASE_URL.
DATABASE_URL="postgresql://user:password@host:5432/railway"

# ── GLM 5.2 (Zhipu AI), OpenAI-совместимый API ──────────────────────────────
# Ключ из личного кабинета Zhipu. baseURL и id модели подтвердить по докам Zhipu.
GLM_API_KEY="your-zhipu-api-key"
GLM_BASE_URL="https://open.bigmodel.cn/api/paas/v4"
GLM_MODEL="glm-5.2"

# ── Авторизация (Auth.js / NextAuth) ────────────────────────────────────────
# Сгенерировать: `openssl rand -base64 32`
AUTH_SECRET="generate-a-random-32-byte-secret"
# Публичный URL приложения (на Railway — домен сервиса).
NEXTAUTH_URL="http://localhost:3000"
