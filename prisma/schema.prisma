// Prisma-схема для «Лилы». БД — PostgreSQL на Railway.
// Модели подобраны под ядро игры (src/game/engine.ts) и авторизацию через Auth.js.
//
// Применение:
//   npx prisma generate
//   npx prisma migrate dev --name init   (локально)
//   npx prisma migrate deploy            (на Railway при деплое)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Авторизация (Auth.js / NextAuth — Prisma adapter)
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  // Для credentials-провайдера (email + пароль). Хэш argon2/bcrypt, не сам пароль.
  passwordHash  String?
  name          String?
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())

  accounts Account[]
  sessions Session[]
  games    Game[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────────────────────────────────────
// Игра «Лила»
// ─────────────────────────────────────────────────────────────────────────────

enum GameStatus {
  awaiting_intention
  awaiting_entry
  in_progress
  finished
}

model Game {
  id        String     @id @default(cuid())
  userId    String
  intention String     @db.Text
  status    GameStatus @default(awaiting_entry)

  position         Int @default(0)
  previousPosition Int @default(0)

  // Мультиплеер: [{name, position, status}]. Пусто = одиночная игра (легаси).
  players            Json @default("[]")
  currentPlayerIndex Int  @default(0)

  createdAt  DateTime  @default(now())
  finishedAt DateTime?

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  moves Move[]

  @@index([userId])
}

enum DiceSource {
  player
  auto
}

// Тип события хода — зеркало MoveEventType из src/game/rules.ts.
enum MoveEvent {
  awaiting_entry
  entry
  normal
  arrow
  snake
  overshoot
  win
}

enum TransitionKind {
  arrow
  snake
}

model Move {
  id     String @id @default(cuid())
  gameId String
  index  Int // порядковый номер хода в партии (1..N)

  dice       Int
  diceSource DiceSource
  event      MoveEvent

  fromPosition   Int
  landedPosition Int // куда встал кубик ДО применения змеи/стрелы
  toPosition     Int // итог ПОСЛЕ перехода

  // Сработавший переход (если был).
  transitionType TransitionKind?
  transitionTo   Int?

  // Клетка для трактовки (= toPosition, либо null при ожидании входа).
  cellNumber Int?

  interpretation String? @db.Text

  // Индекс игрока в массиве game.players (0 для одиночной игры).
  playerIndex Int @default(0)

  createdAt DateTime @default(now())

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, index])
  @@index([gameId])
}
